    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 5,
      "title": "Event Ingestion & Fan-Out Rate (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(hookrelay_events_ingested_total[1m])) by (type)",
          "legendFormat": "Ingested: {{type}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(hookrelay_deliveries_created_total[1m])) by (event_type)",
          "legendFormat": "Fanned-out Deliveries: {{event_type}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 6,
      "title": "Delivery Attempts by Outcome & HTTP Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status, status_code) (rate(hookrelay_deliveries_attempts_total[1m]))",
          "legendFormat": "{{status}} (HTTP {{status_code}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "title": "Delivery Latency & Circuit Breakers",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 16 },
      "id": 7,
      "title": "Outbound Delivery Latency (p50, p90, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(hookrelay_deliveries_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50 (Median)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(hookrelay_deliveries_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(hookrelay_deliveries_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
